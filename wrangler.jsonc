{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orm-pmtiles-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-27",
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "ORM_BUCKET",
      "bucket_name": "orm",
      "remote": true,
    },
  ],
}

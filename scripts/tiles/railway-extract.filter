# The OSM objects the railway extract keeps (osmium tags-filter expressions),
# read by fetch-line-relations.sh and update-line-relations.sh; the nodes the
# kept ways and relations refer to come along.

# Railway lines, transit routes and their route masters, and stop areas.
r/route=railway,train,subway,light_rail,tram,monorail,funicular
r/route_master=train,subway,light_rail,tram,monorail,funicular
r/public_transport=stop_area

# Every railway way: tracks in any state, platforms, station outlines, ...
w/railway

# Stations and stops, which need not lie on a track.
n/railway=station,halt,stop,tram_stop,platform
n/public_transport=station
